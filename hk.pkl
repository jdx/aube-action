amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    // lints GitHub Actions workflows, composite actions and Dependabot config (jdx/jactionlint)
    ["jactionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml", "action.yml", "action.yaml", ".github/actions/**/action.yml", ".github/actions/**/action.yaml", ".github/dependabot.yml", ".github/dependabot.yaml")
        batch = true
        check = new CommandSpec {
            command = "jactionlint {{ files }}"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "jactionlint --fix {{ files }}"
            effect = "write"
        }
    }
}

// The online checks (impostor-commit, known-vulnerable-actions, ...) replace zizmor's online
// audits. They need GITHUB_TOKEN, so they run in `hk check` (CI) but not in pre-commit/fix.
local onlineLinters = new Mapping<String, Step> {
    ["jactionlint-online"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml", "action.yml", "action.yaml", ".github/actions/**/action.yml", ".github/actions/**/action.yaml")
        batch = true
        check = new CommandSpec {
            command = "jactionlint --online {{ files }}"
            effect = "read"
        }
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = new Mapping<String, Step> {
            ...linters
            ...onlineLinters
        }
    }
}
